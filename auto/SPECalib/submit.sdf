universe = vanilla

executable = /eos/user/y/ymaruya/FASER/AHCAL/FAIR/auto/SPECalib/submit.sh
arguments  = $(start_run) $(end_run)

output = /eos/user/y/ymaruya/FASER/AHCAL/FAIR/auto/SPECalib/condor_logs/spe.$(start_run)_$(end_run).$(ClusterId).$(ProcId).out
error  = /eos/user/y/ymaruya/FASER/AHCAL/FAIR/auto/SPECalib/condor_logs/spe.$(start_run)_$(end_run).$(ClusterId).$(ProcId).err
log    = /eos/user/y/ymaruya/FASER/AHCAL/FAIR/auto/SPECalib/condor_logs/spe.$(ClusterId).log

+JobFlavour = "testmatch"
queue start_run end_run from run_starts.txt
