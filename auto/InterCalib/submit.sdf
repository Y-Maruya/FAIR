universe = vanilla

executable = /eos/user/y/ymaruya/FASER/AHCAL/FAIR/auto/InterCalib/submit.sh
arguments  = $(start_run) $(num_veto_events)

output = /eos/user/y/ymaruya/FASER/AHCAL/FAIR/auto/InterCalib/condor_logs/intercalib.$(start_run).$(ClusterId).$(ProcId).out
error  = /eos/user/y/ymaruya/FASER/AHCAL/FAIR/auto/InterCalib/condor_logs/intercalib.$(start_run).$(ClusterId).$(ProcId).err
log    = /eos/user/y/ymaruya/FASER/AHCAL/FAIR/auto/InterCalib/condor_logs/intercalib.$(ClusterId).log

+JobFlavour = "workday"
queue start_run from run_starts.txt
